# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/obfusshield?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# LLVM Service
LLVM_SERVICE_URL=http://localhost:9000

# Redis (for Bull queues — optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379

# File storage (local uploads dir, or swap for S3)
UPLOAD_DIR=./uploads

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:3000
